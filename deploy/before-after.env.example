# Copy to /etc/before-after/before-after.env, chmod 0640, root:before-after.
# Generate a unique value with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
APP_ENV=production
SECRET_KEY=REPLACE_WITH_AT_LEAST_64_RANDOM_URLSAFE_CHARACTERS
DATABASE_URL=postgresql+psycopg://before_after:REPLACE_DB_PASSWORD@127.0.0.1/before_after
MEDIA_ROOT=/var/lib/before-after/media
# bootstrap creates this tree as before-after:before-after-media, setgid 2750.
# nginx is the only trusted proxy in front of Gunicorn.
TRUSTED_PROXY_COUNT=1
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
