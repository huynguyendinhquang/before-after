# Copy to /etc/before-after/restore-check.env, chmod 0600, root:root.
# These values are read from the environment, never passed as command arguments.
# restore_user is the disposable restore-admin role (CREATEDB and DROP DATABASE);
# it is never the production application role.
RESTORE_CHECK_DATABASE_URL=postgresql+psycopg://restore_user:REPLACE_PASSWORD@127.0.0.1/before_after_restore
PRODUCTION_DATABASE_URL=postgresql+psycopg://before_after:REPLACE_PASSWORD@127.0.0.1/before_after
PRODUCTION_MEDIA_ROOT=/var/lib/before-after/media
BACKUP_ROOT=/mnt/clinic-backup/before-after
BACKUP_SOURCE_DATABASE_URL=postgresql+psycopg://before_after:REPLACE_PASSWORD@127.0.0.1/before_after
RESTORE_CHECK_MEDIA_ROOT=/var/lib/before-after/restore-drills/media
RESTORE_CHECK_PARENT=/var/lib/before-after/restore-drills
RESTORE_SMOKE_USERNAME=restore-drill-editor
PG_DUMP=/usr/lib/postgresql/16/bin/pg_dump
PG_RESTORE=/usr/lib/postgresql/16/bin/pg_restore
PSQL=/usr/lib/postgresql/16/bin/psql
