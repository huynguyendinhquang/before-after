# Copy to /etc/before-after/before-after-backup.env, chmod 0640,
# root:before-after-backup. This file contains the read-only backup role
# credential, never the writable application role.
# This URL is intentionally credential-free. Store the password in PGPASSFILE.
# role entry: before_after_backup:
DATABASE_URL=postgresql+psycopg://before_after_backup@127.0.0.1/before_after
PGPASSFILE=/etc/before-after/before-after-backup.pgpass
# The pg_hba isolation proof uses this exact backup-service source.
BACKUP_DB_HOST=127.0.0.1
BACKUP_DB_PORT=5432
BACKUP_HBA_SOURCE_CIDR=127.0.0.1/32
# Optional explicit disposable/non-production database used by bootstrap proof.
# BACKUP_HBA_SECOND_DATABASE=before_after_test
MEDIA_ROOT=/var/lib/before-after/media
# The backup service takes MEDIA_ROOT/.backup.lock exclusively before checking app state.
# The lock is created by bootstrap as before-after:before-after-media, mode 0660.
# Must already exist on a mounted second device; never create this on /.
BACKUP_ROOT=/mnt/clinic-backup/before-after
BACKUP_SERVICE_UNIT=before-after.service
PG_DUMP=/usr/lib/postgresql/16/bin/pg_dump
PG_RESTORE=/usr/lib/postgresql/16/bin/pg_restore
PSQL=/usr/lib/postgresql/16/bin/psql
BACKUP_RETENTION_GENERATIONS=14
