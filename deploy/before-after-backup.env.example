# Copy to /etc/before-after/before-after-backup.env, chmod 0640,
# root:before-after-backup. This file contains the database credential.
DATABASE_URL=postgresql+psycopg://before_after:REPLACE_DB_PASSWORD@127.0.0.1/before_after
MEDIA_ROOT=/var/lib/before-after/media
# The backup service reads MEDIA_ROOT through supplementary group before-after-media.
# Must already exist on a mounted second device; never create this on /.
BACKUP_ROOT=/mnt/clinic-backup/before-after
BACKUP_SERVICE_UNIT=before-after.service
BACKUP_RETENTION_GENERATIONS=14
PG_DUMP=/usr/bin/pg_dump
PG_RESTORE=/usr/bin/pg_restore
